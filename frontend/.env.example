# Base URL of the FastAPI backend, reachable from the Next.js server.
# Inbound requests to /api/* on the Next.js server are proxied here
# (see next.config.ts rewrites).
API_BASE_URL=http://localhost:8000

# Client-visible prefix for the backend API. Kept same-origin so the browser
# talks to Next.js and the rewrites proxy forwards to API_BASE_URL.
NEXT_PUBLIC_API_URL=/api/v1