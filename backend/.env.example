PROJECT_NAME=Citizen Intelligence Layer API
API_V1_PREFIX=/api/v1
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
CORS_ALLOWED_ORIGINS=[]

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/citizen_intelligence
REDIS_URL=redis://localhost:6379/0
RABBITMQ_URL=amqp://guest:guest@localhost:5672//
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_WORKER_CONCURRENCY=2

EVIDENCE_STORAGE_ROOT=/tmp/citizen-intelligence-evidence
EVIDENCE_MAX_SIZE_BYTES=10485760
EVIDENCE_ALLOWED_MIME_TYPES=["application/pdf","image/gif","image/jpeg","image/png","image/webp"]

STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
OPENAI_API_KEY=
JWT_SECRET=replace-with-a-long-random-secret-before-production
